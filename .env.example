# Unginx environment variables
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# When using docker compose, values in .env are picked up automatically and
# substituted into docker-compose.yml.

# ─── Common ──────────────────────────────────────────────────────────────────

# Port nginx listens on inside the container. Must match the right-hand side
# of the "ports" mapping in docker-compose.yml.
APP_PORT=80

# Path the admin UI is served under. Change this if you want to hide it behind
# a less-guessable URL (e.g. /__myadmin-9f2c).
ADMIN_PATH=/__unginx

# First-boot admin credentials. If you leave these unset, the seed user is
# `unginx` / `unginx` and the UI forces a password change on first login.
# If you set them here, the forced-change prompt is skipped.
# UNGINX_USERNAME=admin
# UNGINX_PASSWORD=change-me-now

# Timezone used for log timestamps and history entries.
TZ=UTC

# ─── Advanced (rarely needed) ────────────────────────────────────────────────

# Log level for the backend (pino): trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# Version string shown on the dashboard. Set by CI; defaults to "dev".
# APP_VERSION=1.0.0

# Override the SQLite database path. Default: /data/db/unginx.sqlite
# DB_PATH=/data/db/unginx.sqlite

# Override the unix socket path the backend listens on. Default: /run/unginx/backend.sock
# SOCKET_PATH=/run/unginx/backend.sock

# Override the frontend bundle location. Default: ../web/dist relative to the backend.
# WEB_DIST=/app/web/dist

# ─── Local dev only (not used inside the container) ──────────────────────────

# When set, the backend listens on TCP at this port instead of a unix socket.
# Required for running `pnpm dev` on Windows (no unix sockets there).
# DEV_PORT=3001

# /etc/nginx/conf.d/00-unginx.conf
# Generated from 00-unginx.conf.template at container start.
# Do not edit by hand — changes will be lost on restart.

upstream unginx_backend {
    server unix:/run/unginx/backend.sock;
}

server {
    listen ${APP_PORT} default_server;
    server_name _;

    # Admin UI and API — proxied to the backend via unix socket
    location ${ADMIN_PATH} {
        proxy_pass http://unginx_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE — disable buffering so events arrive immediately
        proxy_buffering    off;
        proxy_read_timeout 1h;
        # WebSocket (future-proofing)
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
    }

    # User routes and file routes — generated by the backend, included from /data/active
    include /data/active/routes.conf;
    include /data/active/files.conf;

    # Fallback: nothing matched
    location / {
        return 404 "No route configured at this path.\n";
        add_header Content-Type text/plain;
    }
}

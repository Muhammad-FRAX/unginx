# /etc/nginx/http.d/00-unginx.conf
# Generated from 00-unginx.conf.template at container start.
# Do not edit by hand — changes will be lost on restart.

# log_format must be at the http context level. Alpine's nginx.conf includes
# /etc/nginx/http.d/*.conf from inside the http {} block, which is correct here.
log_format unginx_combined '$remote_addr - $remote_user [$time_local] '
                           '"$request" $status $body_bytes_sent '
                           '"$http_referer" "$http_user_agent" '
                           'rid=$unginx_route_id rt=$request_time';

upstream unginx_backend {
    server unix:/run/unginx/backend.sock;
}

server {
    listen ${APP_PORT} default_server;
    server_name _;

    # Default value for the custom log variable. Per-route blocks (generated by
    # the backend in /data/active/routes.conf) override this with the real
    # route id. Declaring it here ensures `log_format unginx_combined` is
    # valid even when no user routes are configured yet.
    set $unginx_route_id "-";

    # Bare admin path with no trailing slash → redirect to the canonical
    # form so the SPA's relative asset URLs resolve correctly.
    location = ${ADMIN_PATH} {
        return 301 ${ADMIN_PATH}/;
    }

    # Admin UI and API. The trailing slash on both `location` and `proxy_pass`
    # makes nginx strip the admin path prefix before forwarding, so the
    # backend sees `/`, `/api/...`, `/assets/...` regardless of what
    # ADMIN_PATH is set to.
    location ${ADMIN_PATH}/ {
        proxy_pass http://unginx_backend/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE — disable buffering so events arrive immediately
        proxy_buffering    off;
        proxy_read_timeout 1h;
        # WebSocket (future-proofing)
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
    }

    # User routes and file routes — generated by the backend, included from /data/active
    include /data/active/routes.conf;
    include /data/active/files.conf;

    # Fallback: nothing matched
    location / {
        default_type text/plain;
        return 404 "No route configured at this path.\n";
    }
}
